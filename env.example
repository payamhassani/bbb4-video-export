# Copy to /etc/bbb-video-export/env and fill in your own values.
# Get BBB_URL / BBB_SECRET from: sudo bbb-conf --secret

BBB_URL=https://bbb.example.com/bigbluebutton/api/
BBB_SECRET=changeme

OUTPUT_DIR=/var/bigbluebutton/video-exports
EXPORT_SCRIPT=/usr/local/bin/bbb-export-video.sh
LOG_PATH=/var/log/bbb-video-export/nightly-batch.log

TIMEZONE=Asia/Tehran
WINDOW_START_HOUR=23
WINDOW_END_HOUR=7
